        row["sarima_mae"]   = mae_metric(test_arr, sarima_pred)
        row["sarima_mase"]  = mase(test_arr, sarima_pred, ya_pred)

        # Simulated unfulfilled reduction vs yearly average
        unf_s, unf_ya, red_s = simulated_unfulfilled_reduction(
            unf_test, ful_test, sarima_pred, ya_pred
