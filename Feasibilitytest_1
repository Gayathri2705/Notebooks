        if mase_col in w.columns:
            vals = w[mase_col].dropna()
            rec[f"{model}_mase_median"] = round(vals.median(), 3) \
                if len(vals) > 0 else np.nan
            rec[f"{model}_mase_q25"]    = round(
                vals.quantile(.25), 3) if len(vals) > 0 else np.nan
            rec[f"{model}_mase_q75"]    = round(
                vals.quantile(.75), 3) if len(vals) > 0 else np.nan
            rec[f"{model}_mase_max"]    = round(
                vals.max(), 3) if len(vals) > 0 else np.nan
            rec[f"{model}_spike_rate"]  = round(
                (vals > SPIKE_THRESHOLD).mean(), 3) \
                if len(vals) > 0 else np.nan
            rec[f"{model}_smape_median"] = round(
                w[smape_col].dropna().median(), 2) \
                if smape_col in w.columns else np.nan

        if red_col in w.columns:
            rec[f"{model}_unf_reduction"] = round(
                w[red_col].dropna().median(), 2)

    # Who wins per SKU?
    sarima_m  = rec.get("sarima_mase_median", np.nan)
    chronos_m = rec.get("chronos_mase_median", np.nan)
    timesfm_m = rec.get("timesfm_mase_median", np.nan)

    best_mase = min(
        [(sarima_m,  "sarima"),
         (chronos_m, "chronos"),
         (timesfm_m, "timesfm")],
        key=lambda x: x[0] if not np.isnan(x[0]) else np.inf
    )
    rec["best_model"] = best_mase[1]

    # Is TSFM clearly better than SARIMA on this SKU?
    if not np.isnan(sarima_m) and not np.isnan(chronos_m):
        improvement = (sarima_m - chronos_m) / sarima_m
        rec["chronos_beats_sarima"] = improvement > 0
        rec["chronos_improvement_pct"] = round(
            improvement * 100, 1)
    else:
        rec["chronos_beats_sarima"]     = np.nan
        rec["chronos_improvement_pct"]  = np.nan

    sku_summary.append(rec)

