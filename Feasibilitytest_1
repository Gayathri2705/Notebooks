def load_and_aggregate(ful_path, unf_path):
    """
    Load daily fulfilled and unfulfilled demand.
    Aggregate to calendar monthly totals per SKU.
    Returns monthly DataFrame with columns:
        year_month, sku_id, fulfilled, unfulfilled, total
    """
    ful = pd.read_csv(ful_path, parse_dates=True)
    unf = pd.read_csv(unf_path, parse_dates=True)

    for df in [ful, unf]:
        df.columns = df.columns.str.lower().str.strip()
        for col in list(df.columns):
            if "date" in col:
                df.rename(columns={col: "date"}, inplace=True)
                df["date"] = pd.to_datetime(df["date"])
            if any(x in col for x in
                   ["material", "sku", "item", "product", "part"]):
                df.rename(columns={col: "sku_id"}, inplace=True)
            if any(x in col for x in
                   ["qty", "quantity", "demand", "amount", "volume"]):
                df.rename(columns={col: "quantity"}, inplace=True)

    # Aggregate daily to monthly
    ful["year_month"] = ful["date"].dt.to_period("M")
    unf["year_month"] = unf["date"].dt.to_period("M")

    ful_m = ful.groupby(["year_month", "sku_id"])["quantity"] \
               .sum().reset_index() \
               .rename(columns={"quantity": "fulfilled"})
    unf_m = unf.groupby(["year_month", "sku_id"])["quantity"] \
               .sum().reset_index() \
               .rename(columns={"quantity": "unfulfilled"})

    monthly = pd.merge(ful_m, unf_m,
                       on=["year_month", "sku_id"],
                       how="outer").fillna(0)
    monthly["total"] = monthly["fulfilled"] + monthly["unfulfilled"]

    # Sort by SKU and time
    monthly = monthly.sort_values(
        ["sku_id", "year_month"]
    ).reset_index(drop=True)

    return monthly


