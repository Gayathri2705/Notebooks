def forecast_yearly_average(train, horizon):
    """
    Yearly average baseline — what the company was doing.
    Takes mean of last 12 months and applies flat for horizon.
    """
    last_12 = train[-12:] if len(train) >= 12 else train
    avg     = np.mean(last_12)
    return np.full(horizon, avg)


def forecast_sarima(train, horizon):
    """
    SARIMA with automatic order selection via AIC.
    Seasonal period = 12 (monthly data).
    """
    arr = np.clip(np.array(train, dtype=float), 0, None)

    # Stationarity check
    try:
        d = 0 if adfuller(arr, autolag="AIC")[1] < 0.05 else 1
    except Exception:
        d = 1

    # Candidate orders — seasonal period 12
    configs = [
        ((1, d, 1), (1, 1, 0, 12)),
        ((1, d, 0), (1, 0, 0, 12)),
        ((0, d, 1), (0, 1, 0, 12)),
        ((1, d, 1), (0, 0, 0,  0)),
        ((0, d, 1), (0, 0, 0,  0)),
        ((1, d, 0), (0, 0, 0,  0)),
    ]

    best_aic  = np.inf
    best_pred = None

    for order, seas_order in configs:
        try:
            fit = SARIMAX(
                arr,
                order=order,
                seasonal_order=seas_order,
                enforce_stationarity=False,
                enforce_invertibility=False,
            ).fit(disp=False, maxiter=100)

            if fit.aic < best_aic:
                pred = np.clip(fit.forecast(horizon), 0, None)
                if not (np.any(np.isnan(pred)) or
                        np.any(np.isinf(pred))):
                    best_aic  = fit.aic
                    best_pred = pred
        except Exception:
            continue

    # Fallback to yearly average if all configs fail
    if best_pred is None:
        return forecast_yearly_average(train, horizon)

    return best_pred


