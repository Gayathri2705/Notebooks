        else:
            row["chronos_pred"]              = None
            row["chronos_smape"]             = np.nan
            row["chronos_mae"]               = np.nan
            row["chronos_mase"]              = np.nan
            row["chronos_coverage"]          = np.nan
            row["chronos_unf_reduction_pct"] = np.nan

        # ── TimesFM ──────────────────────────────────────────
