def get_windows(T, n_windows, horizon, min_train):
    """
    Generate rolling origin window indices.

    Each window = (train_end, test_start, test_end)
    where:
      train = series[0 : train_end]
      test  = series[test_start : test_end]
      train_end == test_start (no gap)

    Windows are evenly spaced across valid range.
    Non-overlapping test periods guaranteed.
    """
    min_origin = min_train           # earliest valid train_end
    max_origin = T - horizon         # latest valid train_end

    if max_origin < min_origin:
        return []

    # Evenly spaced origins
    origins = np.linspace(min_origin, max_origin,
                          n_windows, dtype=int)

    # Enforce non-overlapping test windows
    clean = [int(origins[0])]
    for o in origins[1:]:
        o = int(o)
        if o >= clean[-1] + horizon:
            clean.append(o)

    windows = []
    for origin in clean:
        test_end = origin + horizon
        if test_end <= T:
            windows.append((origin, origin, test_end))

    return windows


