def mase(actual, forecast, baseline_forecast):
    """
    MASE scaled against yearly average baseline.

    MASE = MAE(model) / MAE(baseline)

    Value < 1.0 means model beats the baseline.
    Value = 1.0 means model matches the baseline.
    Value > 1.0 means model is worse than the baseline.

    Scaled against yearly average (not naive seasonal)
    because yearly average is the company's actual baseline.
    This directly answers the industrial question.
    """
    actual   = np.array(actual,            dtype=float)
    forecast = np.array(forecast,          dtype=float)
    baseline = np.array(baseline_forecast, dtype=float)

    mae_model    = np.mean(np.abs(actual - forecast))
    mae_baseline = np.mean(np.abs(actual - baseline))

    if mae_baseline == 0:
        return np.nan

    return mae_model / mae_baseline


def smape(actual, forecast):
    """Symmetric MAPE — stable near zero."""
    a    = np.array(actual,   dtype=float)
    f    = np.array(forecast, dtype=float)
    dnom = (np.abs(a) + np.abs(f)) / 2
    mask = dnom > 0
    if mask.sum() == 0:
        return np.nan
    return np.mean(np.abs(a[mask] - f[mask]) / dnom[mask]) * 100


def mae_metric(actual, forecast):
    return np.mean(np.abs(
        np.array(actual, dtype=float) -
        np.array(forecast, dtype=float)
    ))


def coverage(actual, lower, upper):
    """Fraction of actuals inside prediction interval."""
    a = np.array(actual, dtype=float)
    l = np.array(lower,  dtype=float)
    u = np.array(upper,  dtype=float)
    return np.mean((a >= l) & (a <= u))


def simulated_unfulfilled_reduction(actual_unf,
                                    actual_ful,
                                    forecast,
                                    baseline_forecast):
    """
    Simulate unfulfilled order reduction.

    Logic:
    - If company had ordered forecast units in advance,
      and actual demand = actual_ful + actual_unf,
      then unfulfilled = max(0, total_demand - forecast)
    - Compare unfulfilled under model forecast vs
      unfulfilled under baseline forecast

    Returns: (unfulfilled_model, unfulfilled_baseline,
              reduction_pct)

    Positive reduction = model reduces unfulfilled orders.
    Negative reduction = model makes it worse.
    """
    total_demand = np.array(actual_ful,  dtype=float) \
                 + np.array(actual_unf,  dtype=float)
    f  = np.array(forecast,          dtype=float)
    b  = np.array(baseline_forecast, dtype=float)

    unf_model    = np.sum(np.maximum(0, total_demand - f))
    unf_baseline = np.sum(np.maximum(0, total_demand - b))

    if unf_baseline == 0:
        return unf_model, unf_baseline, np.nan

    reduction_pct = (unf_baseline - unf_model) / unf_baseline * 100

    return unf_model, unf_baseline, round(reduction_pct, 2)


