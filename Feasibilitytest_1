def forecast_chronos(train, horizon):
    """
    Chronos 2 zero-shot forecast.
    Returns median, 10th percentile, 90th percentile.
    """
    if not CHRONOS_OK:
        return None, None, None
    try:
        ctx = torch.tensor(
            train, dtype=torch.float32
        ).unsqueeze(0)
        with torch.no_grad():
            samples = chronos_pipe.predict(
                ctx,
                prediction_length=horizon,
                num_samples=CHRONOS_NSAMPLES,
            )
        # samples: (1, n_samples, horizon)
        s      = samples[0].float().numpy()
        median = np.clip(np.median(s, axis=0), 0, None)
        lower  = np.clip(np.percentile(s, 10, axis=0), 0, None)
        upper  = np.clip(np.percentile(s, 90, axis=0), 0, None)
        return median, lower, upper
    except Exception as e:
        print(f"    Chronos error: {e}")
        return None, None, None


def forecast_timesfm(train, horizon):
    """TimesFM zero-shot forecast. Returns point prediction."""
    if not TIMESFM_OK:
        return None
    try:
        inp   = [train.tolist()]
        freq  = [0]   # 0 = default frequency
        pred, _ = tfm.forecast(inp, freq=freq)
        return np.clip(np.array(pred[0])[:horizon], 0, None)
    except Exception as e:
        print(f"    TimesFM error: {e}")
        return None


