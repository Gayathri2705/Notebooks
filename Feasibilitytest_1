def classify_sku(arr):
    """
    Compute ADI and CV² on fulfilled monthly demand.
    Returns adi, cv2, demand_class.

    Uses FULFILLED signal for classification because:
    - This reflects what the planning system observes
    - Classification should match real operational data
    - Avoids inflating demand class difficulty artificially
    """
    nz = arr[arr > 0]
    n  = len(arr)
    if len(nz) < 2:
        return np.nan, np.nan, "unknown"
    adi = n / len(nz)
    cv2 = (nz.std(ddof=1) / nz.mean()) ** 2
    if adi < ADI_THRESHOLD and cv2 < CV2_THRESHOLD:
        cls = "smooth"
    elif adi < ADI_THRESHOLD:
        cls = "erratic"
    elif cv2 < CV2_THRESHOLD:
        cls = "intermittent"
    else:
        cls = "lumpy"
    return round(adi, 4), round(cv2, 4), cls


