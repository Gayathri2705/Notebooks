import pandas as pd


def load_and_classify_m4(file_path: str) -> tuple[pd.DataFrame, pd.Series]:
    """Loads M4 CSV data, classifies time series patterns (Syntetos-Boylan rule),

    reshapes to long format, and returns the long DataFrame along with category counts.
    """
    # 1. Load wide data
    wide = pd.read_csv(file_path, index_col="V1").astype("float32")

    # 2. Calculate ADI and CV^2 per series (row-wise in wide format)
    nz = wide.where(wide > 0)
    total_periods = wide.notna().sum(axis=1)
    nz_periods = nz.notna().sum(axis=1)

    adi = total_periods / nz_periods
    cv2 = (nz.std(axis=1, ddof=0) / nz.mean(axis=1)) ** 2

    # 3. Classify demand patterns (Syntetos-Boylan / Croston thresholds: ADI=1.32, CV^2=0.49)
    category = pd.Series("smooth", index=wide.index, dtype="category")
    is_intermittent = (adi >= 1.32) & (cv2 < 0.49)
    is_erratic = (adi < 1.32) & (cv2 >= 0.49)
    is_lumpy = (adi >= 1.32) & (cv2 >= 0.49)

    category[is_intermittent] = "intermittent"
    category[is_erratic] = "erratic"
    category[is_lumpy] = "lumpy"

    category_summary = category.value_counts(normalize=True)

    # 4. Reshape to long format
    df = (
        wide.stack()
        .rename("y")
        .rename_axis(["unique_id", "col"])
        .reset_index()
        .drop(columns="col")
    )

    df["ds"] = df.groupby("unique_id").cumcount()
    df["unique_id"] = df["unique_id"].astype("category")

    # 5. Map classifications to long format
    df["category"] = df["unique_id"].map(category)

    return df, category_summary


