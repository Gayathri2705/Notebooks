                       "demand_class"].values[0]
    unf_arr  = series_unf[sku]
    smask    = np.array([v > 0 for v in unf_arr])

    origins  = get_rolling_windows_idx(
        N_DAYS, N_WINDOWS, FORECAST_HORIZON, MIN_TRAIN_DAYS
    )

    for w_idx, origin in enumerate(origins):
        window_mask = smask[origin:origin + FORECAST_HORIZON]
        n_so_total  = window_mask.sum()
        n_so_first  = window_mask[:FORECAST_HORIZON // 3].sum()
        n_so_mid    = window_mask[
            FORECAST_HORIZON // 3:2 * FORECAST_HORIZON // 3
        ].sum()
        n_so_last   = window_mask[
            2 * FORECAST_HORIZON // 3:
        ].sum()

        front_load  = (n_so_first / n_so_total
                       if n_so_total > 0 else np.nan)

