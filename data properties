"""
Front-loading ratio = fraction of stockout days in the first
third of the forecast window.

High front-loading (>0.6) means the model is being asked to
forecast into a period that BEGINS under supply constraint —
the hardest scenario.
"""


def get_rolling_windows_idx(n, n_windows, horizon, min_train):
    min_start = min_train
    max_start = n - horizon
    if max_start <= min_start:
        return []
    origins = np.linspace(min_start, max_start,
                          n_windows, dtype=int)
    clean   = [origins[0]]
    for o in origins[1:]:
        if o >= clean[-1] + horizon:
            clean.append(o)
    return clean


