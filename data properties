def load_demand(ful_path, unf_path):
    ful = pd.read_csv(ful_path, parse_dates=True)
    unf = pd.read_csv(unf_path, parse_dates=True)
    for df in [ful, unf]:
        df.columns = df.columns.str.lower().str.strip()
        for col in list(df.columns):
            if "date" in col:
                df.rename(columns={col: "date"}, inplace=True)
                df["date"] = pd.to_datetime(df["date"])
            if any(x in col for x in
                   ["material", "sku", "item", "product", "part"]):
                df.rename(columns={col: "sku_id"}, inplace=True)
            if any(x in col for x in
                   ["qty", "quantity", "demand", "amount", "volume"]):
                df.rename(columns={col: "quantity"}, inplace=True)
    ful_d = ful.groupby(["date", "sku_id"])["quantity"].sum() \
               .reset_index().rename(columns={"quantity": "fulfilled"})
    unf_d = unf.groupby(["date", "sku_id"])["quantity"].sum() \
               .reset_index().rename(columns={"quantity": "unfulfilled"})
    daily = pd.merge(ful_d, unf_d, on=["date", "sku_id"],
                     how="outer").fillna(0)
    daily["total"] = daily["fulfilled"] + daily["unfulfilled"]
    return daily.sort_values(["sku_id", "date"]).reset_index(drop=True)


