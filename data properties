def detect_break(arr, min_frac=BREAK_MIN_FRAC):
    """
    Sliding window Mann-Whitney test.
    Tests every possible split point after min_frac of series.
    Returns: break_idx, p_value, magnitude (post/pre mean ratio)
    """
    n        = len(arr)
    min_idx  = int(n * min_frac)
    max_idx  = int(n * (1 - min_frac))

    if min_idx >= max_idx:
        return None, 1.0, np.nan

    best_p   = 1.0
    best_idx = None

    for idx in range(min_idx, max_idx):
        pre  = arr[:idx]
        post = arr[idx:]
        if len(pre) < 10 or len(post) < 10:
            continue
        try:
            _, p = mannwhitneyu(pre, post, alternative="two-sided")
            if p < best_p:
                best_p   = p
                best_idx = idx
        except Exception:
            continue

    if best_idx is None:
        return None, 1.0, np.nan

    pre_mean  = arr[:best_idx].mean()
    post_mean = arr[best_idx:].mean()
    magnitude = (post_mean / pre_mean
                 if pre_mean > 0 else np.nan)

    return best_idx, round(best_p, 6), round(magnitude, 4)


