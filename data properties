def compute_adi_cv2(arr):
    arr = np.array(arr, dtype=float)
    n   = len(arr)
    nz  = arr[arr > 0]
    if len(nz) < 2:
        return np.nan, np.nan
    adi = n / len(nz)
    cv2 = (nz.std(ddof=1) / nz.mean()) ** 2
    return round(adi, 4), round(cv2, 4)


def classify(adi, cv2):
    if pd.isna(adi) or pd.isna(cv2):
        return "unknown"
    if adi < ADI_THRESHOLD and cv2 < CV2_THRESHOLD:
        return "smooth"
    elif adi < ADI_THRESHOLD:
        return "erratic"
    elif cv2 < CV2_THRESHOLD:
        return "intermittent"
    return "lumpy"


