def get_episodes(unf_arr, min_days=MIN_STOCKOUT_DAYS):
    """Identify contiguous stockout episodes."""
    episodes = []
    in_ep    = False
    start    = 0
    for i, v in enumerate(unf_arr):
        if v > 0 and not in_ep:
            in_ep = True
            start = i
        elif v == 0 and in_ep:
            if i - start >= min_days:
                episodes.append((start, i - 1))
            in_ep = False
    if in_ep and len(unf_arr) - start >= min_days:
        episodes.append((start, len(unf_arr) - 1))
    return episodes


