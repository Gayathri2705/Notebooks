def compute_local_cv(arr, window=LOCAL_VOL_WINDOW):
    """
    Compute coefficient of variation (std/mean) within
    rolling windows across the series.
    Returns array of local CV values.
    """
    cvs = []
    for i in range(len(arr) - window):
        w = arr[i:i + window]
        nz = w[w > 0]
        if len(nz) > 1 and nz.mean() > 0:
            cvs.append(nz.std() / nz.mean())
        else:
            cvs.append(np.nan)
    return np.array(cvs)


