        "demand_class":     cls,
        "local_cv_median":  round(np.nanmedian(cvs), 4),
        "local_cv_q25":     round(np.nanpercentile(cvs, 25), 4),
        "local_cv_q75":     round(np.nanpercentile(cvs, 75), 4),
        "local_cv_max":     round(np.nanmax(cvs), 4),
        "local_cv_std":     round(np.nanstd(cvs), 4),
        "cv_time_variation": round(np.nanstd(cvs) / np.nanmedian(cvs), 4)
